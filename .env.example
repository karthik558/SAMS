# Frontend: the anon key is public; database access is enforced by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only: never add VITE_ prefixes to secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=

# Optional local operator credential for the Supabase CLI; never commit its value.
SUPABASE_DB_PASSWORD=
